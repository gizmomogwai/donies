name "donie"
description "CLI tool to manage Creative Tonies via the Tonie Cloud API"
authors "Christian Köstlin"
license "MIT"
targetType "executable"
targetPath "out/main/"

dependency "argparse" version="~>2.0.2"
dependency "requests" version="~>2.2.0"
dependency "colored" version="~>0.0.33"
dependency "progressbar" path="../10-progressbar4d"
dependency "asciitable" version="~>0.0.17"
dependency "mir-ion" version="~>2.3.5"
